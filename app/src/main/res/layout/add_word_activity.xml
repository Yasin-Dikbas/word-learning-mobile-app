<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/ivSmallLogo"
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/loop_words_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/ivSmallLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yeni Kelime Kaydet"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A4B8F"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"/>

                <FrameLayout
                    android:id="@+id/frameImagePicker"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/edittext_background"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:id="@+id/ivSelectedImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#D1D1D1" />
                </FrameLayout>

                <EditText
                    android:id="@+id/etEnglishWord"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="İngilizce Kelime *"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="15dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etTurkishWord"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Türkçe Karşılığı *"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="15dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <EditText
                        android:id="@+id/etPhonetic"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:hint="Fonetik"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="15dp"
                        android:layout_marginEnd="6dp"
                        android:inputType="text"/>
                    <EditText
                        android:id="@+id/etTurkishReading"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="1"
                        android:hint="Okunuş"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="15dp"
                        android:layout_marginStart="6dp"
                        android:inputType="text"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAddWordDifficultyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kelime Zorluğu: 3"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <SeekBar
                    android:id="@+id/seekBarAddWordDifficulty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="4"
                    android:progress="2"
                    android:progressTint="#1A4B8F"
                    android:thumbTint="#1A4B8F"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Örnek Cümleler *"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="16dp"/>

                <LinearLayout
                    android:id="@+id/containerSentences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnAddSentence"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Yeni Cümle Ekle"
                    android:textColor="#1A4B8F"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btnSaveWord"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:text="KELİMEYİ KAYDET"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#1A4B8F" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>