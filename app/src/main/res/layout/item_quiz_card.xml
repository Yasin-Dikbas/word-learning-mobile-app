<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quizCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp"
    app:cardCornerRadius="32dp"
    app:cardElevation="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layoutQuestion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvQuizWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHALLENGE"
                android:textColor="#1A4B8F"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.6"
                android:text="Bu kelimenin anlamı nedir?"
                android:textColor="#2E4053"
                android:textSize="14sp" />

            <View
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:layout_marginVertical="32dp"
                android:background="#E3F2FD" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOption1"
                style="@style/QuizOptionButtonStyle"
                android:text="Seçenek A" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOption2"
                style="@style/QuizOptionButtonStyle"
                android:text="Seçenek B" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOption3"
                style="@style/QuizOptionButtonStyle"
                android:text="Seçenek C" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOption4"
                style="@style/QuizOptionButtonStyle"
                android:text="Seçenek D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F0F7FF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hemen Hatırlayalım!"
                android:textColor="#FF5252"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInfoTurkish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Meydan Okuma"
                android:textColor="#1A4B8F"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInfoPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="/ˈtʃæl.ɪndʒ/"
                android:textColor="#3D5AFE"
                android:textSize="18sp"
                android:textStyle="italic" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="#D1E4FF" />

            <TextView
                android:id="@+id/tvInfoSentenceEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="It was a great challenge for me."
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInfoSentenceTr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="(Benim için büyük bir meydan okumaydı.)"
                android:textColor="#616161"
                android:textSize="16sp" />

            <android.widget.Button
                android:id="@+id/btnNextAfterError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:backgroundTint="#3D5AFE"
                android:text="ANLADIM, DEVAM ET"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>