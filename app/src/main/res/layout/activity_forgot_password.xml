<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient">

    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ŞİFRE KURTARMA"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1A4B8F"
        app:layout_constraintBottom_toTopOf="@+id/forgotCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7" />

    <androidx.cardview.widget.CardView
        android:id="@+id/forgotCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/etForgotUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="E-Posta Adresi"
                android:background="@drawable/edittext_background"
                android:paddingLeft="15dp"
                android:layout_marginBottom="12dp"
                android:inputType="textPersonName"/>

            <android.widget.Button
                android:id="@+id/btnFindUser"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SORUYU GETİR"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_background"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:id="@+id/layoutSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDisplayQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Güvenlik Sorunuz Buraya Gelecek"
                    android:textColor="#2E4053"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvDisplayHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="İpucu: ..."
                    android:textColor="#566573"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etForgotAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Cevabınızı Yazın"
                    android:background="@drawable/edittext_background"
                    android:paddingLeft="15dp"
                    android:layout_marginBottom="20dp"
                    android:inputType="text"/>

                <android.widget.Button
                    android:id="@+id/btnVerifyAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="DOĞRULA"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/button_background"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>